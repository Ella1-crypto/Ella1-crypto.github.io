[Unit]
Description=보유세맵 VWorld 중계 서버
After=network-online.target
Wants=network-online.target

[Service]
User=relay
WorkingDirectory=/opt/holding-tax-api
EnvironmentFile=/etc/holding-tax-relay.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
